<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.7" />
    
  </ItemGroup>

  <PropertyGroup>
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>

  <!-- Same statically linked DuckDB as Arm B. The difference is purely WHERE it runs:
       Arm B calls it on the UI thread, Arm C calls it from a .NET Web Worker. -->
  <ItemGroup>
    <NativeFileReference Include="$(MSBuildThisFileDirectory)../../artifacts/duckdb-wasm-static/libcore_functions_extension.a" />
    <NativeFileReference Include="$(MSBuildThisFileDirectory)../../artifacts/duckdb-wasm-static/libduckdb_fastpforlib.a" />
    <NativeFileReference Include="$(MSBuildThisFileDirectory)../../artifacts/duckdb-wasm-static/libduckdb_fmt.a" />
    <NativeFileReference Include="$(MSBuildThisFileDirectory)../../artifacts/duckdb-wasm-static/libduckdb_fsst.a" />
    <NativeFileReference Include="$(MSBuildThisFileDirectory)../../artifacts/duckdb-wasm-static/libduckdb_hyperloglog.a" />
    <NativeFileReference Include="$(MSBuildThisFileDirectory)../../artifacts/duckdb-wasm-static/libduckdb_mbedtls.a" />
    <NativeFileReference Include="$(MSBuildThisFileDirectory)../../artifacts/duckdb-wasm-static/libduckdb_miniz.a" />
    <NativeFileReference Include="$(MSBuildThisFileDirectory)../../artifacts/duckdb-wasm-static/libduckdb_pg_query.a" />
    <NativeFileReference Include="$(MSBuildThisFileDirectory)../../artifacts/duckdb-wasm-static/libduckdb_re2.a" />
    <NativeFileReference Include="$(MSBuildThisFileDirectory)../../artifacts/duckdb-wasm-static/libduckdb_skiplistlib.a" />
    <NativeFileReference Include="$(MSBuildThisFileDirectory)../../artifacts/duckdb-wasm-static/libduckdb_static.a" />
    <NativeFileReference Include="$(MSBuildThisFileDirectory)../../artifacts/duckdb-wasm-static/libduckdb_utf8proc.a" />
    <NativeFileReference Include="$(MSBuildThisFileDirectory)../../artifacts/duckdb-wasm-static/libduckdb_yyjson.a" />
    <NativeFileReference Include="$(MSBuildThisFileDirectory)../../artifacts/duckdb-wasm-static/libduckdb_zstd.a" />
    <NativeFileReference Include="$(MSBuildThisFileDirectory)../../artifacts/duckdb-wasm-static/libparquet_extension.a" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Demo.Shared\Demo.Shared.csproj" />
    <ProjectReference Include="..\Demo.ArmC.Worker\Demo.ArmC.Worker.csproj" />
  </ItemGroup>
</Project>
